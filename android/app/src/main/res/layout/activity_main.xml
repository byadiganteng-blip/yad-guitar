<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="8dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎸"
            android:textSize="24sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="YAD Guitar"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvChordInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#8B5CF6"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#2A2A4E" />
    </LinearLayout>

    <!-- FRETBOARD -->
    <com.yad.guitar.GuitarView
        android:id="@+id/guitarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- RECORDING CONTROLS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0A0A14"
        android:padding="6dp">

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🎙️ REC"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EF4444"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="⏹️ STOP"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#64748B"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnPlayRec"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="▶️ PLAY"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="💾 SAVE"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnAutoTune"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🎼 TUNE"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F59E0B"
            android:layout_marginStart="3dp" />
    </LinearLayout>

    <!-- RECORDING STATUS -->
    <TextView
        android:id="@+id/tvRecStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tekan REC untuk merekam"
        android:textSize="11sp"
        android:textColor="#94A3B8"
        android:gravity="center"
        android:padding="4dp"
        android:background="#0A0A14" />

    <!-- CHORD BUTTONS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#0A0A14"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/chordContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <!-- CONTROL BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btnStrumDown"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="⬇️ STRUM"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8B5CF6"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnStrumUp"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="⬆️ UP"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EC4899"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnAutoStrum"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="🎵 AUTO"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnPattern"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="🎼 PATTERN"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F59E0B"
            android:layout_marginStart="3dp" />
    </LinearLayout>

</LinearLayout>
