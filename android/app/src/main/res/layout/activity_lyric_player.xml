<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A14"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵"
            android:textSize="22sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lyric Player"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvTranspose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8B5CF6"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#2A2A4E"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnTransposeDown"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="−"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EF4444"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnTransposeUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLyricStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upload file lirik (.txt) untuk mulai"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:gravity="center"
        android:padding="8dp"
        android:background="#1A1A2E"
        android:layout_marginBottom="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLyric"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A2E"
        android:padding="8dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#1A1A2E"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎼"
            android:textSize="16sp"
            android:layout_marginEnd="8dp" />

        <SeekBar
            android:id="@+id/seekBarTempo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="#8B5CF6"
            android:thumbTint="#8B5CF6" />

        <TextView
            android:id="@+id/tvBpm"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="100 BPM"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8B5CF6"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btnLyricUpload"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="📁 UPLOAD"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnLyricPlay"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="▶️ PLAY"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnLyricStop"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="⏹️ STOP"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EF4444"
            android:layout_marginStart="3dp" />
    </LinearLayout>

</LinearLayout>
